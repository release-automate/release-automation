CONFLUENCE_API_TOKEN=ATATT3xFfGF02VFCWpIgfGw-5n5PNk49jRWACkl0iqIHAph0grVSRn-nQr_91Y4vCIMadsUr3FiGP0xxHDAQ6TZ8_H3bvxSRJ8-vDi-WE2UtonVo-ZryGb4j8z5p9jLBNV39sRTuHpUQGajx6W7Z6d_P_YJc3J7xn38v0bZ6w-ryEIjFviVcqF0=9E3BCB54

# Space key where release pages will be created, e.g. REL
CONFLUENCE_SPACE_KEY=Release-Automate

# Page ID of the parent "Release Notes" page (find it in the page URL)
CONFLUENCE_PARENT_PAGE_ID=327709

# ── GitHub ─────────────────────────────────────────────────────
# Personal Access Token with repo + read:org scopes
# Create at https://github.com/settings/tokens
GH_TOKEN=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

# Your GitHub organisation name
