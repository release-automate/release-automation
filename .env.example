# ── OpenAI ─────────────────────────────────────────────────────
# API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_api_key

# Model to use — gpt-4o recommended for quality, gpt-4o-mini for cost
OPENAI_MODEL=gpt-4o

# ── Express server (Flow 3 — JIRA webhook receiver) ────────────
PORT=3000

# Shared secret configured in the JIRA webhook settings
WEBHOOK_SECRET=your_random_webhook_secret

# ── Behaviour ──────────────────────────────────────────────────
# Set to "true" in CI/dry-run mode to skip actual JIRA/Confluence writes
DRY_RUN=false
